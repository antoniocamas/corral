;;; setup-corral.el.example --- template config for corral -*- lexical-binding: t; -*-

;; Copy this into your own init (e.g. as setup-corral.el, loaded from
;; init.el the way you load any other package config) and edit the
;; placeholders. This file is not loaded by corral itself -- it's a
;; template, kept out of the installed package (see AGENTS.md's
;; Repository Structure: examples/ isn't part of the shipped package).
;;
;; This is the production template: installing from a pushed remote.
;; If you're developing corral itself against a local checkout, see
;; setup-corral-devel.el.example instead.

;;; Commentary:

;; M-x corral-show-panel   -- open the side panel
;; M-x corral-launch-claude -- the default `claude' variant
;;
;; Registering a variant (below) auto-generates its own launch
;; command: corral-launch-claude-<variant-name>. Each prompts for a
;; directory, then a session-name suffix (pre-filled with a sensible
;; default), and tracks the resulting vterm buffer in the panel.
;;
;; M-x corral-claude-install-hooks merges corral's own hooks into
;; ~/.claude/settings.json -- shows a diff and asks for confirmation
;; before writing anything. Not called automatically here on purpose:
;; it's a real edit to a hand-maintained config file, run it
;; deliberately when you want it.

;;; Code:

;; --- Installation ---
;;
;; A pushed GitHub/GitLab/Codeberg/sr.ht remote is recognized
;; automatically by package-vc's URL-sniffing heuristic.
;;
;; package-vc-install only clones what's committed as of whenever it
;; last ran -- it isn't live against the remote. To pick up new
;; releases automatically on startup, `corral--sync-upgrade' below
;; fast-forwards the installed checkout.
;;
;; It does NOT use `package-vc-upgrade', deliberately: that drives an
;; *asynchronous* `vc-pull' whose result is swallowed by
;; `with-demoted-errors', so `(require 'corral)' on the next line runs
;; before the pull finishes -- loading the still-old files. On a fresh
;; daemon this left the installed copy silently stale (new commits, or
;; a just-added harness, never appeared). A synchronous `git fetch' +
;; `--ff-only' merge completes before `require'; `--ff-only' refuses
;; rather than clobbering, so any local edits are safe.
(defun corral--sync-upgrade ()
  "Fast-forward corral's package-vc checkout synchronously, before load."
  (let ((dir (ignore-errors
               (package-vc--checkout-dir (cadr (assq 'corral package-alist))))))
    (when (and dir (file-directory-p (expand-file-name ".git" dir)))
      (let ((default-directory dir))
        (call-process "git" nil nil nil "fetch" "origin")
        (call-process "git" nil nil nil "merge" "--ff-only" "origin/main")))))

(if (package-installed-p 'corral)
    (corral--sync-upgrade)
  (package-vc-install "https://github.com/antoniocamas/corral"))

(require 'corral)

;; --- Launch variants ---
;;
;; The default "claude" variant already exists (registered by
;; corral-claude.el itself). Add your own personal wrapper scripts,
;; flags, or alternate accounts/models as additional named variants --
;; corral only needs the literal command string; your wrapper handles
;; its own environment/auth/flags however it likes.
;;
;;   (corral-harness-add-variant 'claude "<variant-name>" "<shell command, with any flags>")

;; Example: a variant that skips permission prompts entirely, useful
;; for a throwaway/sandboxed project you fully trust.
(corral-harness-add-variant 'claude "yolo" "claude --dangerously-skip-permissions")

;;; setup-corral.el.example ends here
